  "entry": "gml_GlobalScript_scr_damage",
  "find": "global\\.hp\\[chartarget\\] -= round\\(tdamage / 4\\);\\n(\\s*)hpdiff = round\\(tdamage / 4\\);",
  "replace": "hpdiff = 0;",
