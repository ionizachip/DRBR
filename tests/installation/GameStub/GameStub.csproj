<Project Sdk="Microsoft.NET.Sdk">
  <!-- TESTS ONLY: a stand-in for DELTARUNE.exe under Wine (the real game cannot run here). It does what the DRBR build's
       start does with the files (drbr_save54.gml: kdr_boot / kdr_frame) so the launcher's PLAY can be tested end to end. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DELTARUNE</AssemblyName>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
