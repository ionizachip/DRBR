<Project Sdk="Microsoft.NET.Sdk">
  <!-- DRBR's core logic tests: the same source files as the Windows programs, on .NET (Linux or Windows) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Drbr</RootNamespace>
    <AssemblyName>drbr-tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Drbr.Core\*.cs" LinkBase="Core" />
  </ItemGroup>
</Project>
